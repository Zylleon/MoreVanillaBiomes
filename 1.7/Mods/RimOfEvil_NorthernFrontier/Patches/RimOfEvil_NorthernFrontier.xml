            <ZBiome_Iceberg_NoBeach>0.12</ZBiome_Iceberg_NoBeach>
            <ZBiome_GlacialShield>0.16</ZBiome_GlacialShield>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName = "Wolf_ROE_Nordberg"]/race/wildBiomes</xpath>
