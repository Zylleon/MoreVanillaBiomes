            <ZBiome_AlpineMeadow>0.02</ZBiome_AlpineMeadow>
            <ZBiome_Iceberg_NoBeach>0.03</ZBiome_Iceberg_NoBeach>
            <ZBiome_GlacialShield>0.03</ZBiome_GlacialShield>
